# dwsim-runner — on-prem image (GPL-3.0)
# Contains ONLY our GPL wrapper. DWSIM is NOT included: the customer installs
# DWSIM themselves and mounts it at /opt/dwsim. You therefore never convey
# DWSIM binaries — only this wrapper (source available) and the iskra app.
#
# Build note: compiling the Worker requires DWSIM assemblies present at build
# time (reference-only, Private=false). They are fetched into the BUILD stage
# only, are used for compilation metadata, and are NOT copied into the publish
# output or the runtime stage below — asserted mechanically twice, at the end of
# this stage and again by scripts/verify-no-conveyance.sh against the final image.
#
# This stage used to `COPY dwsim/ /opt/dwsim/` from the build context. That broke
# silently when the SaaS Dockerfile moved to an in-build fetch and `.dockerignore`
# gained a `dwsim/` line: the directory stops being uploaded as context, so the
# COPY fails with `"/dwsim": not found` and THIS IMAGE CANNOT BE BUILT AT ALL.
# Which means `verify-no-conveyance.sh` — the load-bearing Constitution IV proof —
# could not run either, and CI does not invoke it, so nothing said so. Fetching
# here mirrors the SaaS Dockerfile and makes the check runnable from a clean clone.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY scripts/fetch-dwsim.sh ./scripts/
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && scripts/fetch-dwsim.sh /opt/dwsim
ENV DWSIM_PATH=/opt/dwsim
COPY src/ ./src/
RUN dotnet publish src/DwsimRunner.Api    -c Release -o /out/api && \
    dotnet publish src/DwsimRunner.Worker -c Release -o /out/worker && \
    # belt & braces: assert nothing from the DWSIM install leaked into any
    # publish output — DWSIM.* assemblies AND the Skia libs the Worker
    # references for PFD rendering (002/T054; resolved from DWSIM_PATH at run).
    ! ls /out/api /out/worker | grep -qiE '^(DWSIM\.|SkiaSharp|libSkiaSharp)'

FROM mcr.microsoft.com/dotnet/aspnet:8.0
# coinor-libipopt1v5: DWSIM's own release ships /opt/dwsim/libIpopt39.so as a
# SYMLINK to /usr/lib/libipopt.so.1 and expects the distro to provide the target.
# Without it the symlink dangles and any solve reaching the nonlinear solver kills
# the worker outright — `DllNotFoundException: Unable to load shared library
# 'Ipopt39'`, exit 134, no result. Measured 2026-08-08 on the eval corpus: 13 of
# 18 NRTL cases died on this; the same documents converge under PR and SRK, so it
# reads as a property-package limitation rather than a missing runtime dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libfontconfig1 libgdiplus libc6-dev curl coinor-libipopt1v5 \
    && rm -rf /var/lib/apt/lists/*

# Non-root: the wrapper never needs root, even with a customer DWSIM mount.
RUN useradd --system --uid 10001 --create-home --home-dir /home/runner runner \
    && mkdir -p /tmp/dwsim \
    && chown -R runner:runner /tmp/dwsim
ENV TMPDIR=/tmp/dwsim

COPY --from=build /out/api    /app/api
COPY --from=build /out/worker /app/worker

# Customer mounts:
#   -v /path/to/their/dwsim:/opt/dwsim:ro
#   -v /path/to/templates:/templates:ro
ENV DWSIM_PATH=/opt/dwsim \
    TEMPLATES_PATH=/templates \
    WORKER_PATH=/app/worker/DwsimRunner.Worker.dll \
    LD_LIBRARY_PATH=/opt/dwsim \
    SOLVE_TIMEOUT_SECONDS=60 \
    MAX_CONCURRENT_SOLVES=6

EXPOSE 8080
WORKDIR /app/api
USER runner
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1
ENTRYPOINT ["dotnet", "DwsimRunner.Api.dll"]

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Worker unit tier (spec 141 T012/T013): exercises the parameter binder against the
       REAL DWSIM classes, so like the Worker it needs DWSIM assemblies at DWSIM_PATH for
       both build and run. CI has no DWSIM and does not run this project (same reason the
       Worker itself is not built there — see .github/workflows/ci.yml). Run it via the
       docker SDK pattern with the image's DWSIM install mounted at /opt/dwsim:

         docker cp [runner-container]:/opt/dwsim ./local-dwsim
         docker run [rm] -v $PWD:/src -v $PWD/local-dwsim:/opt/dwsim -w /src \
           mcr.microsoft.com/dotnet/sdk:8.0 \
           dotnet test tests/DwsimRunner.Worker.Tests -c Release

       No flowsheet or Automation3 boot: the tests construct unit-op objects directly,
       so they stay fast and deterministic. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DwsimRunner.Worker/DwsimRunner.Worker.csproj" />
  </ItemGroup>

  <!-- Same resolution contract as the Worker: referenced from an existing install,
       Private=false so nothing GPL is copied into our output. -->
  <PropertyGroup>
    <DwsimPath>$(DWSIM_PATH)</DwsimPath>
    <DwsimPath Condition="'$(DwsimPath)' == ''">/opt/dwsim</DwsimPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DWSIM.Interfaces">
      <HintPath>$(DwsimPath)/DWSIM.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DWSIM.SharedClasses">
      <HintPath>$(DwsimPath)/DWSIM.SharedClasses.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DWSIM.UnitOperations">
      <HintPath>$(DwsimPath)/DWSIM.UnitOperations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ShortcutColumn implements ICapeIdentification; the compiler needs the defining assembly. -->
    <Reference Include="CapeOpen">
      <HintPath>$(DwsimPath)/CapeOpen.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
